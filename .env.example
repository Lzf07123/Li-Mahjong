# 复制为 .env 后按需修改；docker compose 会自动读取同目录 .env
# 管理后台等敏感信息务必在生产环境修改！

# ---------- 服务端 ----------

# 管理后台口令（/admin 登录用，生产环境必须修改！默认 admin123）
ADMIN_TOKEN=change-me-please

# 宿主机映射端口（默认 3000）
PORT=3000

# 反向代理信任开关（默认关闭）。仅当部署在单层可信反代（如本机 nginx）后时开启，
# 限流将取 X-Forwarded-For 最后一跳作为客户端 IP；直连部署开启会被伪造请求头绕过限流！
# TRUST_PROXY=1

# 跳过图形验证码校验（仅供自动化测试使用，生产切勿开启；默认关闭）
# ALLOW_TEST_CAPTCHA=1

# ---------- 构建 ----------

# npm 镜像源（构建镜像时安装依赖用；国内服务器推荐 npmmirror）
NPM_REGISTRY=https://registry.npmmirror.com

# apt 加速镜像（构建镜像时安装编译工具链用；留空 = 官方源 deb.debian.org）
# 国内可选：mirrors.tuna.tsinghua.edu.cn（清华）/ mirrors.aliyun.com（阿里）/ mirrors.ustc.edu.cn（中科大）
#APT_MIRROR=mirrors.tuna.tsinghua.edu.cn

# ---------- 前端开发（仅 docker-compose.dev.yml 生效）----------

# Vite 开发服务器代理的后端地址（compose 网络内为 http://server:3000）
# VITE_API_TARGET=http://server:3000
